---
import type { Language } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-corporate-border py-10 mt-auto">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-corporate-secondary">
    
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 rounded bg-corporate-primary text-white flex items-center justify-center font-bold text-[10px]">
        CQ
      </div>
      <span>© {currentYear} Christian Quidel. {t['footer.rights']}</span>
    </div>

    <div class="flex items-center gap-6">
      <span class="text-corporate-muted">{t['footer.timezone']} <strong class="text-corporate-secondary font-medium">UTC-3 (Argentina)</strong></span>
      <a href="https://github.com/reddjedet" target="_blank" rel="noopener noreferrer" class="hover:text-corporate-accent transition-colors">GitHub</a>
      <a href="https://linkedin.com/in/quidelchristian" target="_blank" rel="noopener noreferrer" class="hover:text-corporate-accent transition-colors">LinkedIn</a>
      <a href="https://x.com/CDanqui" target="_blank" rel="noopener noreferrer" class="hover:text-corporate-accent transition-colors">Twitter / X</a>
    </div>

  </div>
</footer>
