---
import type { LocalizedProject } from '../data/projects';
import type { Language } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  project: LocalizedProject;
  lang?: Language;
}

const { project, lang = 'en' } = Astro.props;
const t = ui[lang];
---

<div class="bg-white border border-corporate-border rounded-xl p-6 shadow-corporate hover:border-corporate-focus hover:shadow-corporate-hover card-hover flex flex-col justify-between">
  
  <div class="space-y-4">
    
    <!-- Header -->
    <div class="flex flex-wrap items-start justify-between gap-2 border-b border-corporate-border pb-3">
      <div>
        <span class="text-xs font-semibold text-corporate-accent tracking-wider uppercase block">{project.role}</span>
        <h3 class="text-lg sm:text-xl font-bold text-corporate-primary mt-0.5">{project.title}</h3>
      </div>
      <span class="text-xs font-medium text-corporate-muted bg-corporate-subtle px-2.5 py-1 rounded-md">
        {project.date}
      </span>
    </div>

    <!-- Description -->
    <p class="text-sm text-corporate-secondary leading-relaxed">
      {project.description}
    </p>

    <!-- Key Metrics Grid -->
    {project.metrics && project.metrics.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 bg-corporate-subtle p-3 rounded-lg border border-corporate-border">
        {project.metrics.map(m => (
          <div class="text-center">
            <div class="text-xs text-corporate-muted font-medium">{m.label}</div>
            <div class="text-sm font-bold text-corporate-primary mt-0.5">{m.value}</div>
          </div>
        ))}
      </div>
    )}

    <!-- Highlights List -->
    <div class="space-y-1.5 pt-1">
      <h4 class="text-xs font-bold text-corporate-primary uppercase tracking-wider">{t['projects.techTitle']}</h4>
      <ul class="space-y-1.5 text-xs text-corporate-secondary">
        {project.highlights.map(h => (
          <li class="flex items-start gap-2">
            <span class="text-corporate-accent mt-0.5">•</span>
            <span class="leading-relaxed">{h}</span>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <!-- Tech Stack & Links Footer -->
  <div class="mt-6 pt-4 border-t border-corporate-border space-y-4">
    
    <!-- Badges -->
    <div class="flex flex-wrap gap-1.5">
      {project.technologies.map(tech => (
        <span class="px-2 py-0.5 bg-corporate-subtle border border-slate-200 text-corporate-secondary rounded text-[11px] font-medium">
          {tech}
        </span>
      ))}
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center justify-between pt-1">
      <a 
        href={project.githubUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-corporate-primary hover:text-corporate-accent transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
        {t['projects.repoBtn']}
      </a>

      {project.liveDemoUrl && (
        <a 
          href={project.liveDemoUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-corporate-accent hover:underline"
        >
          {t['projects.demoBtn']}
        </a>
      )}
    </div>

  </div>

</div>
