---
import type { Tweet } from '../data/tweets';

interface Props {
  tweet: Tweet;
}

const { tweet } = Astro.props;

// Formatting content: split lines into paragraphs
const paragraphs = tweet.content.split(/\n\n+/);
---

<article class="bg-white border border-corporate-border rounded-xl p-5 shadow-sm hover:border-corporate-focus hover:shadow-corporate-hover card-hover flex flex-col justify-between">
  
  <div>
    <!-- Author Header -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">
          CQ
        </div>
        <div class="leading-tight">
          <div class="flex items-center gap-1.5">
            <span class="font-bold text-corporate-primary text-sm">{tweet.author.name}</span>
            {tweet.author.verified && (
              <svg class="w-4 h-4 text-sky-500 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="m8.6 22.5-1.9-3.2-3.6-.8.4-3.7L1 12l2.5-2.8-.4-3.7 3.6-.8 1.9-3.2L12 2.9l3.4-1.4 1.9 3.2 3.6.8-.4 3.7L23 12l-2.5 2.8.4 3.7-3.6.8-1.9 3.2-3.4-1.4-3.4 1.4zM10.95 15.55 16.6 9.9l-1.4-1.45-4.25 4.25-2.15-2.1-1.4 1.4 3.55 3.5z"/>
              </svg>
            )}
          </div>
          <span class="text-xs text-corporate-muted">@{tweet.author.handle} · {tweet.date}</span>
        </div>
      </div>

      <span class="text-[11px] font-semibold text-corporate-accent bg-corporate-accent-light px-2.5 py-0.5 rounded-full border border-corporate-accent-border">
        {tweet.category}
      </span>
    </div>

    <!-- Tweet Content -->
    <div class="text-sm text-corporate-primary space-y-2 mb-4 leading-relaxed font-normal whitespace-pre-line">
      {paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <!-- Hashtags -->
    {tweet.hashtags && tweet.hashtags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {tweet.hashtags.map((tag) => (
          <span class="text-xs font-medium text-sky-600 hover:text-sky-700">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Footer Actions & Metrics -->
  <div class="pt-3 border-t border-corporate-border flex items-center justify-between text-xs text-corporate-muted">
    
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1 hover:text-sky-600 transition-colors" title="Respuestas">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        {tweet.metrics.replies}
      </span>
      <span class="flex items-center gap-1 hover:text-emerald-600 transition-colors" title="Republicaciones">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        {tweet.metrics.retweets}
      </span>
      <span class="flex items-center gap-1 hover:text-rose-600 transition-colors" title="Me gusta">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        {tweet.metrics.likes}
      </span>
    </div>

    <!-- External Link to X -->
    <a 
      href={tweet.tweetUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-corporate-accent hover:text-corporate-accent-hover font-semibold transition-colors group"
    >
      Ver en X
      <svg class="w-3 h-3 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
    </a>

  </div>

</article>
