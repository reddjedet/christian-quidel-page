---
import type { Language } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  lang?: Language;
  currentPath?: string;
}

const { lang = 'en', currentPath = Astro.url.pathname } = Astro.props;
const t = ui[lang];
const isSpanish = lang === 'es';

// Resolve target URL for language switcher
function getTargetUrl(targetLang: Language): string {
  const path = currentPath;
  if (targetLang === 'es') {
    if (path === '/') return '/es';
    if (path.startsWith('/es')) return path;
    if (path === '/proyectos') return '/es/proyectos';
    if (path === '/cv') return '/es/cv';
    if (path === '/tweets') return '/es/tweets';
    return `/es${path}`;
  } else {
    // Switching to EN
    if (path === '/es' || path === '/es/') return '/';
    if (path.startsWith('/es/')) {
      return path.replace('/es/', '/');
    }
    return path;
  }
}

const navLinks = [
  { label: t['nav.home'], href: isSpanish ? '/es' : '/' },
  { label: t['nav.projects'], href: isSpanish ? '/es#proyectos' : '/#proyectos' },
  { label: t['nav.tweets'], href: isSpanish ? '/es/tweets' : '/tweets' },
  { label: t['nav.metrics'], href: isSpanish ? '/es#metricas' : '/#metricas' },
  { label: t['nav.about'], href: isSpanish ? '/es#sobre-mi' : '/#sobre-mi' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-corporate-border transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    
    <!-- Logo / Brand -->
    <a href={isSpanish ? '/es' : '/'} class="flex items-center gap-2.5 group flex-shrink-0">
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-corporate-primary text-white flex items-center justify-center font-bold text-xs sm:text-sm shadow-sm group-hover:bg-corporate-accent btn-transition flex-shrink-0">
        CQ
      </div>
      <div class="whitespace-nowrap">
        <span class="font-bold text-corporate-primary text-xs sm:text-sm md:text-base leading-tight block">Christian Quidel</span>
        <span class="text-[10px] sm:text-[11px] text-corporate-secondary font-medium block">Data Scientist Trainee</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-3 lg:gap-6 text-xs lg:text-sm font-medium text-corporate-secondary flex-shrink-0">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="whitespace-nowrap hover:text-corporate-accent transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-corporate-accent after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:origin-left"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Actions, Socials & Language Switcher -->
    <div class="flex items-center gap-1 sm:gap-2 lg:gap-2.5 flex-shrink-0">
      
      <!-- Language Switcher Pill -->
      <div class="flex items-center bg-corporate-subtle p-0.5 rounded-lg border border-corporate-border text-xs font-semibold flex-shrink-0">
        <a 
          href={getTargetUrl('en')} 
          class={`px-2 py-1 rounded-md transition-all whitespace-nowrap ${lang === 'en' ? 'bg-corporate-primary text-white shadow-xs' : 'text-corporate-secondary hover:text-corporate-primary'}`}
          title="English version"
        >
          EN
        </a>
        <a 
          href={getTargetUrl('es')} 
          class={`px-2 py-1 rounded-md transition-all whitespace-nowrap ${lang === 'es' ? 'bg-corporate-primary text-white shadow-xs' : 'text-corporate-secondary hover:text-corporate-primary'}`}
          title="Versión en Español"
        >
          ES
        </a>
      </div>

      <!-- Social Icons -->
      <a 
        href="https://linkedin.com/in/quidelchristian" 
        target="_blank" 
        rel="noopener noreferrer"
        class="p-1.5 sm:p-2 text-corporate-secondary hover:text-corporate-accent hover:bg-corporate-accent-light rounded-lg transition-colors flex-shrink-0"
        aria-label="LinkedIn de Christian Quidel"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25a1.66 1.66 0 0 0-1.67 1.66 1.66 1.66 0 0 0 1.67 1.67 1.66 1.66 0 0 0 1.67-1.67c0-.92-.75-1.66-1.67-1.66Z"/></svg>
      </a>

      <a 
        href="https://github.com/reddjedet" 
        target="_blank" 
        rel="noopener noreferrer"
        class="p-1.5 sm:p-2 text-corporate-secondary hover:text-corporate-accent hover:bg-corporate-accent-light rounded-lg transition-colors flex-shrink-0"
        aria-label="GitHub de Christian Quidel"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
      </a>

      <a 
        href="https://x.com/CDanqui" 
        target="_blank" 
        rel="noopener noreferrer"
        class="p-1.5 sm:p-2 text-corporate-secondary hover:text-corporate-accent hover:bg-corporate-accent-light rounded-lg transition-colors flex-shrink-0"
        aria-label="Twitter / X de Christian Quidel (@CDanqui)"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>

      <a 
        href={isSpanish ? '/es/cv' : '/cv'} 
        class="hidden sm:inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 rounded-lg bg-corporate-accent text-white text-xs font-semibold hover:bg-corporate-accent-hover btn-transition shadow-sm shadow-blue-500/20 whitespace-nowrap flex-shrink-0"
      >
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>{t['nav.downloadCV']}</span>
      </a>
    </div>

  </div>
</header>
