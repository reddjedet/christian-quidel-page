---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import TweetCard from '../components/TweetCard.astro';
import Footer from '../components/Footer.astro';
import { tweetsData } from '../data/tweets';
import { ui } from '../i18n/ui';

const lang = 'en';
const t = ui[lang];
---

<Layout 
  title="Microblog & Tweets | Christian Quidel" 
  description="Curated collection of technical tweets and threads on Machine Learning, MLOps, ONNX inference, Cloud, and Data Philosophy."
>
  <Navbar lang={lang} currentPath="/tweets" />

  <main class="flex-1 py-12 sm:py-16 bg-corporate-bg">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- Header -->
      <div class="border-b border-corporate-border pb-6 space-y-2">
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-corporate-accent bg-corporate-accent-light px-2.5 py-1 rounded border border-corporate-accent-border">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          Microblogging
        </div>
        <h1 class="text-3xl font-extrabold text-corporate-primary">{t['tweets.pageTitle']}</h1>
        <p class="text-sm text-corporate-secondary max-w-2xl">
          {t['tweets.pageSubtitle']}
        </p>
      </div>

      <!-- Feed Grid -->
      {tweetsData.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {tweetsData.map(tweet => (
            <TweetCard tweet={tweet} />
          ))}
        </div>
      ) : (
        <div class="bg-white border border-corporate-border rounded-xl p-8 text-center space-y-4 shadow-sm max-w-xl mx-auto">
          <div class="w-12 h-12 rounded-full bg-sky-50 text-sky-600 flex items-center justify-center mx-auto">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-base font-bold text-corporate-primary">{t['tweets.emptyTitle']}</h3>
            <p class="text-xs text-corporate-secondary max-w-md mx-auto leading-relaxed">
              {t['tweets.emptyDesc']}
            </p>
          </div>
        </div>
      )}

      <!-- How to follow box -->
      <div class="bg-white border border-corporate-border rounded-xl p-6 text-center space-y-3 shadow-sm">
        <h3 class="text-base font-bold text-corporate-primary">{t['tweets.realtimeTitle']}</h3>
        <p class="text-xs text-corporate-secondary max-w-md mx-auto">
          {t['tweets.realtimeDesc']}
        </p>
        <a 
          href="https://x.com/CDanqui" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-corporate-primary text-white text-xs font-semibold hover:bg-slate-800 btn-transition"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          {t['tweets.connectX']}
        </a>
      </div>

    </div>
  </main>

  <Footer lang={lang} />
</Layout>
