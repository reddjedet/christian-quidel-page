---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Footer from '../../components/Footer.astro';
import { projectsData } from '../../data/projects';
import { ui } from '../../i18n/ui';

const lang = 'es';
const t = ui[lang];
---

<Layout 
  title="Proyectos de Data Science & MLOps | Christian Quidel" 
  description="Portafolio completo de proyectos de Machine Learning, Procesamiento de Lenguaje Natural y MLOps desarrollados por Christian Quidel."
  lang={lang}
>
  <Navbar lang={lang} currentPath="/es/proyectos" />

  <main class="flex-1 py-12 sm:py-16 bg-corporate-bg">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- Header -->
      <div class="border-b border-corporate-border pb-6 space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-corporate-accent bg-corporate-accent-light px-2.5 py-1 rounded border border-corporate-accent-border">
          {t['projects.tag']}
        </span>
        <h1 class="text-3xl font-extrabold text-corporate-primary mt-2">{t['projects.title']}</h1>
        <p class="text-sm text-corporate-secondary max-w-2xl">
          {t['projects.subtitle']}
        </p>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projectsData.es.map(project => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>

    </div>
  </main>

  <Footer lang={lang} />
</Layout>
